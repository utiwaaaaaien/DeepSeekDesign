{
  "name": "@local/deepseek-design-workbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A code animation workbench for DeepSeek Harness.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "export-worker.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "icon.png",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-file-drag"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/utiwaaaaaien/DeepSeekDesign.git",
    "directory": "deepseek-design-plugin"
  },
  "bugs": {
    "url": "https://github.com/utiwaaaaaien/DeepSeekDesign/issues"
  },
  "homepage": "https://github.com/utiwaaaaaien/DeepSeekDesign#readme",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "code-animation",
    "canvas",
    "video"
  ]
}
